<idea-plugin>
    <id>dev.silverhorn.fca.maven-consistency-enforcer</id>

    <name>Maven Consistency Enforcer</name>

    <vendor email="contact@finncu.dev">finncu</vendor>

    <description>
        <![CDATA[
# Maven Consistency Enforcer (MCE)

Stop fighting ghosts in your classpath!

MCE solves the frustrating problem of stale JAR artifacts preventing your code changes from reaching the running application in IntelliJ IDEA multimodule Maven projects.

**What it does:**
- Automatically removes attached jars
- Ensures what you see in your editor matches exactly what runs in your JVM

**Default behavior:**
- Triggers automatically after Maven > Reload Project
- Shows notifications about fixed dependencies
- Re-enforces consistency on every Maven reload

        plugin description
    ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.idea.maven</depends>
<!---->
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            instance="dev.silverhorn.fca.maven_consistency_enforcer.settings.EnforcerSettingsConfigurable"
            id="dev.silverhorn.fca.maven_consistency_enforcer.settings"
            displayName="Maven Consistency Enforcer"
            nonDefaultProject="true"
            groupId="tools"/>
        <search.optionContributor implementation="dev.silverhorn.fca.maven_consistency_enforcer.settings.EnforcerSearchableOptionContributor"/>
        <notificationGroup id="Maven Consistency Enforcer" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

<!--    <actions>-->
<!--        <action id="MCE.PurgeArtifacts" class="dev.silverhorn.fca.maven_consistency_enforcer.actions.PurgeArtifactAction" text="MCE: Purge Stale Artifacts" description="Delete target/build directories and enforce module consistency">-->
<!--            <add-to-group group-id="ToolsMenu" anchor="last"/>-->
<!--        </action>-->
<!--    </actions>-->

    <actions>
        <action id="dev.silverhorn.fca.maven_consistency_enforcer.settings.MceTogglePluginAction"
                class="dev.silverhorn.fca.maven_consistency_enforcer.settings.actions.MceTogglePluginAction"
                text="Maven Consistency Enforcer: Enable Plugin"
                description="Toggle the automatic Maven consistency enforcements on or off">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="dev.silverhorn.fca.maven_consistency_enforcer.settings.MceToggleForceModulesAction"
                class="dev.silverhorn.fca.maven_consistency_enforcer.settings.actions.MceToggleForceModulesAction"
                text="Maven Consistency Enforcer: Force Local Module Usage"
                description="Toggle enforcement of local module dependencies over Maven artifacts">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="dev.silverhorn.fca.maven_consistency_enforcer.listeners.MceMavenReloadListener" topic="org.jetbrains.idea.maven.project.MavenImportListener"/>
    </projectListeners>
</idea-plugin>
